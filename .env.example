# Copy to .env and fill in. .env is gitignored - never commit it.
# Webex bot access token from developer.webex.com (My Webex Apps > your bot)
WEBEX_BOT_TOKEN=
# Router credentials used by the Part 3 backends
ROUTER_USER=
ROUTER_PASS=
# Optional: host port for the published webhook, default 8000
# HOST_PORT=8000
# Optional: host port for the tunnel metrics endpoint, default 2000
# METRICS_PORT=2000
